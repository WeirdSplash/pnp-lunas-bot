# Copia este archivo a .env y completa. Permisos: chmod 600 .env
# (systemd no acepta comentarios al final de la línea: déjalos en su propia línea)
PNP_DNI=
PNP_CLAVE=
TG_TOKEN=
TG_CHAT_ID=

# --- Opcionales ---
# días y horas activas (hora Lima). 0=lunes ... 6=domingo. formato días=inicio-fin;días=inicio-fin
ACTIVE_SCHEDULE="0,1,2,3,4=7-16;5=7-13"
# hora pico (mañanas): revisa más seguido
PEAK_HOURS=7-11
PEAK_INTERVAL_MIN=20
# intervalo el resto del horario
INTERVAL_MIN=45
# minutos para responder captcha / código del correo
ANSWER_TIMEOUT_MIN=10
# 1 = LIMA-LA VICTORIA
SEDE_VALUE=1
DATA_DIR=/opt/pnp-lunas-bot/data
