# Copia este archivo a .env y completa. Permisos: chmod 600 .env
# (systemd no acepta comentarios al final de la línea: déjalos en su propia línea)
PNP_DNI=
PNP_CLAVE=
TG_TOKEN=
TG_CHAT_ID=

# --- Opcionales ---
# cada cuántos minutos revisa
INTERVAL_MIN=45
# solo revisa entre estas horas (hora Lima), inicio-fin
ACTIVE_HOURS=7-20
# 0=lunes ... 6=domingo
ACTIVE_DAYS=0,1,2,3,4,5
# minutos para responder captcha / código del correo
ANSWER_TIMEOUT_MIN=10
# 1 = LIMA-LA VICTORIA
SEDE_VALUE=1
DATA_DIR=/opt/pnp-lunas-bot/data
